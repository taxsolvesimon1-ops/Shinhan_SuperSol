{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/beta", "destination": "/beta/index.html" },
    { "source": "/beta/", "destination": "/beta/index.html" },
    { "source": "/((?!beta(?:/|$)).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/((?!beta(?:/|$)).*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/beta/intro.mp4", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
